          "raw": "{\r\n    \"can_take_calls\": true,\r\n    \"coffee_price\": \"£2.40\",\r\n    \"has_sockets\": true,\r\n    \"has_toilet\": false,\r\n    \"has_wifi\": true,\r\n    \"img_url\": \"https://lh3.googleusercontent.com/\",\r\n    \"location\": \"AAA\",\r\n    \"map_url\": \"https://g.page\",\r\n    \"name\": \"TEST CAFE ADD\",\r\n    \"seats\": \"20-30\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://127.0.0.1:5000/add?",
